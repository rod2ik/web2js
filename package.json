{
    "name": "web2js",
    "version": "1.0.2",
    "description": "Convert \"Pascal\" output of WEB into JavaScript",
    "author": "Jim Fowler",
    "contributors": [
        "Glenn Rice",
        "Rodrigo Schwencke"
    ],
    "license": "GPL-3.0",
    "main": "index.js",
    "packageManager": "yarn@1.22.22",
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "test": "node spec/run-tests.js",

        "build:parser": "jison parser.jison",
        "build:tie": "tie -m tex.web texk/tex.web $(cat changes/change-order)",
        "build:tangle": "tangle -underline tex.web",
        "build:compile": "node compile.js tex.p out.wasm",
        "build:wasm": "yarn build:tie && yarn build:tangle && yarn build:compile",
        "build:asyncify-wasm": "wasm-opt --asyncify --pass-arg=asyncify-ignore-indirect --pass-arg=asyncify-imports@library.reset,library.getfilesize -O4 out.wasm -o tex.wasm",
        "build:initex": "node initex.js",
        "build": "yarn build:parser && yarn build:wasm && yarn build:asyncify-wasm && yarn build:initex",

        "gen:tikz-libs": "node genTikzLibJSON.js",
        "gen:tikz-packages": "node genTikzPackagesJSON.js",
        "gen:tex-files": "node genTexFilesJSON.js",
        "gen:all": "yarn gen:tikz-libs && yarn gen:tikz-packages && yarn gen:tex-files",

        "build:all": "yarn build && yarn gen:all",

        "deploy:tikzjax:tex-files": "node deployTikzjaxTexFiles.js",
        "deploy:wasm:dump": "node deployWasmDump.js",
        "deploy:tikzjax": "yarn deploy:tikzjax:tex-files && yarn deploy:wasm:dump",
        "deploy": "yarn deploy:tikzjax"
    },
    "dependencies": {
        "binaryen": "^99.0.0",
        "flex-js": "^1.0.4",
        "jison": "^0.4.18",
        "node-kpathsea": "github:kisonecat/node-kpathsea"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^2.12.1",
        "colors": "^1.4.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "glob": "^11.0.0",
        "log-symbols": "^2.2.0",
        "prettier": "^3.4.2"
    }
}