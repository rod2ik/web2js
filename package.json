{
    "name": "web2js",
    "version": "1.0.3",
    "description": "Convert \"Pascal\" output of WEB into JavaScript",
    "author": "Jim Fowler",
    "contributors": [
        "Glenn Rice",
        "Rodrigo Schwencke"
    ],
    "license": "GPL-3.0",
    "main": "src/compiler/index.js",
    "packageManager": "yarn@4.17.1",
    "scripts": {
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "javascript:check": "yarn lint:check",
        "architecture:check": "node scripts/architecture-check.mjs",
        "doctor": "node scripts/doctor.mjs",
        "clean": "node scripts/build/clean.mjs",
        "clean:runtime": "node scripts/build/clean.mjs --runtime",
        "clean:docs": "node scripts/build/clean.mjs --docs",
        "dev": "node scripts/dev-docs.mjs",
        "dev:lan": "WEB2JS_DEV_HOST=0.0.0.0 node scripts/dev-docs.mjs",
        "test": "node scripts/test/run-specs.js",
        "test:tex-packages": "node scripts/test/test-tex-packages.js",
        "build:parser": "jison src/compiler/parser.jison -o build/parser.js",
        "build:tie": "node scripts/build/run-tie.mjs",
        "build:tangle": "node scripts/build/run-tangle.mjs",
        "build:compile": "node src/compiler/compile.js build/tex.p build/out.wasm",
        "build:wasm": "yarn build:tie && yarn build:tangle && yarn build:compile",
        "build:asyncify-wasm": "wasm-opt --asyncify --pass-arg=asyncify-ignore-indirect --pass-arg=asyncify-imports@library.reset,library.getfilesize -O4 build/out.wasm -o build/tex.wasm",
        "build:initex": "node scripts/build/initex.js",
        "build:dist": "node scripts/build/stage-dist.mjs",
        "build:gzip": "node scripts/build/gzip-artifacts.mjs",
        "build": "yarn clean:runtime && yarn build:parser && yarn build:wasm && yarn build:asyncify-wasm && yarn build:initex && yarn build:dist && yarn build:gzip",
        "gen:tikz-libs": "node scripts/generate/gen-tikz-libs.js",
        "gen:tikz-packages": "node scripts/generate/gen-tikz-packages.js",
        "gen:tex-files": "node scripts/generate/gen-tex-files.js",
        "gen:all": "yarn gen:tikz-libs && yarn gen:tikz-packages && yarn gen:tex-files",
        "build:all": "yarn build && yarn gen:all",
        "build:docs": "node scripts/build-docs.mjs",
        "build:full": "yarn build:all && yarn build:docs",
        "validate:dist": "node scripts/build/validate-dist.mjs",
        "check": "yarn architecture:check && yarn validate:dist",
        "build:full:check": "yarn build:full && yarn check",
        "bfc": "yarn build:full:check",
        "deploy:tikzjax:tex-files": "node scripts/deploy/deploy-tikzjax-tex-files.js",
        "deploy:tikzjax:runtime": "node scripts/deploy/deploy-tikzjax-runtime.mjs",
        "deploy:wasm:dump": "yarn deploy:tikzjax:runtime",
        "deploy:tikzjax": "yarn gen:tex-files && yarn deploy:tikzjax:tex-files && yarn deploy:tikzjax:runtime",
        "deploy": "yarn deploy:tikzjax",
        "zip": "node scripts/create-project-zip.mjs"
    },
    "dependencies": {
        "binaryen": "^99.0.0",
        "flex-js": "^1.0.4",
        "jison": "^0.4.18",
        "node-kpathsea": "https://codeload.github.com/kisonecat/node-kpathsea/tar.gz/7218125216579a676f093a9b6a7b71202afef2f7"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^2.12.1",
        "colors": "^1.4.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "glob": "^11.0.0",
        "log-symbols": "^2.2.0",
        "node-gyp": "13.0.1",
        "prettier": "^3.4.2",
        "typescript": "6.0.3"
    }
}
